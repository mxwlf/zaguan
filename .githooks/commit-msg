#!/usr/bin/env bash
# Adapted from the file generated by pre-commit: https://pre-commit.com
# ID: 138fd403232d2ddd5efb44317e38bf03
#
# Only deviation from the generated script: `pre-commit` is resolved from the
# repo-local virtualenv created by `make setup` instead of from PATH. That keeps
# the hooks independent of any globally installed pre-commit/Python, and means
# the hooks' own `language: python` environments are built with .venv's
# interpreter (see the note in .pre-commit-config.yaml).

# start templated
ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=commit-msg)
# end templated

HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS+=(--hook-dir "$HERE" -- "$@")

# .githooks/ sits at the repository root, so .venv/ is one level up.
REPO_ROOT="$(cd "$HERE/.." && pwd)"

for candidate in \
    "$REPO_ROOT/.venv/bin/pre-commit" \
    "$REPO_ROOT/.venv/Scripts/pre-commit.exe"
do
    if [ -x "$candidate" ]; then
        exec "$candidate" "${ARGS[@]}"
    fi
done

echo 'Error: `pre-commit` was not found in this repository'"'"'s .venv/.' 1>&2
echo '       Run `make setup` from the repository root to create it.' 1>&2
exit 1

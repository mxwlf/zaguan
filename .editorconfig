# Aspire's service defaults, which are a composition root.
#
# CA1506 counts the distinct types a type references, and this one wires up OpenTelemetry logging,
# metrics and tracing, health checks, service discovery and the standard resilience handler. Being
# coupled to 47 types from 33 namespaces is what the file is FOR: every one of those references is
# a service being registered, and the number goes up with each integration the host adopts. The
# threshold in eng/analyzers/CodeMetricsConfig.txt stays where it is for code that has a choice.
#
# Scoped by filename rather than by path so a project rename does not quietly re-enable it, and set
# to `none` rather than `suggestion` because there is no action to take — the alternative is
# splitting registration across files to make a metric smaller, which buys nothing a reader wants.
[**/ServiceDefaultsExtensions.cs]
dotnet_diagnostic.CA1506.severity = none







# Generated code, which this repository did not write and cannot fix.
#
# Only RS0030 needs saying. Roslyn excludes generated files from analysis by default and most
# analyzers accept that, but BannedApiAnalyzers opts into analyzing generated code, so the banned
# list reaches code produced by other people's tooling. xunit's test entry point is the case that
# forced this: xunit.v3.msbuildtasks writes XunitAutoGeneratedEntryPoint.cs with
# `ConsoleRunner.Run(args).GetAwaiter().GetResult()` in Main — correct there, since Main is the one
# place that genuinely has to block — and the GetResult ban in BannedSymbols.txt turned that into a
# Release error in every test project.
#
# Scoped to the artifacts tree rather than to that one filename so the next generator to emit a
# banned call does not repeat the exercise. $(ArtifactsPath) in Directory.Build.props puts all
# generated output here, including the obj/ trees.
[artifacts/**.cs]
dotnet_diagnostic.RS0030.severity = none

# Legacy FxCop API-design rules, all shipped disabled. They constrain a public surface that other
# languages and COM can consume, which is exactly the bar a library published to a feed should
# meet. CA1014 and CA1017 are satisfied by the assembly attributes in Directory.Build.targets.
dotnet_diagnostic.CA1005.severity = warning
dotnet_diagnostic.CA1014.severity = warning
dotnet_diagnostic.CA1017.severity = warning
dotnet_diagnostic.CA1021.severity = warning
dotnet_diagnostic.CA1045.severity = warning

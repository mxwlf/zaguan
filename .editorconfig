# The remaining 27. These are already enabled by default, so this block is not switching them on -
# it pins the severity so that a change to an analyzer's own default cannot quietly demote one.
# Platform compatibility (CA1416-CA1422), the P/Invoke and span correctness rules, and the `await`
# and exception-rethrow checks are all here.
dotnet_diagnostic.CA1416.severity = warning

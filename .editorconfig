# ----------------------------------------------------------------------------------------------
# The ASP.NET Core and Blazor analyzers, pinned here for the same reason as the CA block above
#
# These ship with the Web SDK and the ASP.NET Core shared framework rather than as NuGet packages,
# so eng/analyzers/all-rules.globalconfig does not cover them: it is scoped to analyzers whose
# versions are pinned, and these move with the SDK. Same trade as the CA block — stable text, in
# exchange for a list that has to be extended by hand.
#
# All 44 of them, enumerated by reflecting over the analyzer assemblies the compiler actually
# loads. That is worth saying because the obvious source is wrong: the generated file only ever
# listed nine of these, because @(ResolvedAnalyzers) and @(Analyzer) between them do not surface the
# ones that arrive through the targeting pack — Microsoft.AspNetCore.App.Analyzers, which carries
# ASP0003 to ASP0028, and Microsoft.AspNetCore.Components.Analyzers, which carries BL0001 to BL0009,
# were never queried at all. Taking the generated file as the inventory undercounted by 35 rules.
#
# Inert until a project uses the Web SDK — an entry for a rule whose analyzer is not loaded is
# ignored with no diagnostic, which was verified rather than assumed. So this costs nothing in a
# repository with no web project, and is already right in one that grows its first.
# ----------------------------------------------------------------------------------------------

# The five that ship at `Info`, which never fails a build however strict the rest of the setup is.
# These are the only entries in this block that change what the compiler does today; the rest pin a
# severity that already applied.
dotnet_diagnostic.ASP0015.severity = warning
dotnet_diagnostic.ASP0018.severity = warning
dotnet_diagnostic.ASP0025.severity = warning
dotnet_diagnostic.ASP0027.severity = warning
dotnet_diagnostic.ASP0028.severity = warning

# Shipped at warning already. Listed so that a change to an analyzer's own default cannot quietly
# demote one of them below the level this build fails at.
dotnet_diagnostic.ASP0000.severity = warning
dotnet_diagnostic.ASP0001.severity = warning
dotnet_diagnostic.ASP0003.severity = warning
dotnet_diagnostic.ASP0004.severity = warning
dotnet_diagnostic.ASP0005.severity = warning

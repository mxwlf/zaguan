dotnet_diagnostic.ASP0019.severity = warning
dotnet_diagnostic.ASP0022.severity = warning
dotnet_diagnostic.ASP0023.severity = warning
dotnet_diagnostic.ASP0026.severity = warning
dotnet_diagnostic.MVC1000.severity = warning
dotnet_diagnostic.MVC1001.severity = warning

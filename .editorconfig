# Editor and code-style configuration for the whole repository.
#
# WHY THIS FILE IS NOT OPTIONAL
# -----------------------------
# Directory.Build.props sets <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>, which loads
# the IDE* code-style analyzers into every compilation. That property only decides whether the
# analyzers RUN; it says nothing about what severity their findings get. A code-style rule's
# severity can only come from an .editorconfig or a .globalconfig — there is no MSBuild property
# that sets it, and <AnalysisMode>All</AnalysisMode> does not reach them (the SDK config it selects,
# analysislevel_<n>_all.globalconfig, contains CA entries and no IDE entry at all).
#
# So without this file the code-style analyzers ran on every build and reported nothing, because
# their built-in defaults are `suggestion` and `silent` and neither of those fails a build or even
# prints. Mangled indentation, `( 1 + 2 )` and a stray `( string s )` compiled clean in Release.
#
# The same reasoning applies to the naming rules at the bottom. IDE1006 is "naming rule violation",
# and the rules it checks are the `dotnet_naming_rule` entries declared here — with none declared
# it has nothing to compare against and can never fire, however high its severity is set.
#
# WHERE EACH LAYER OF CONFIGURATION LIVES
# ---------------------------------------
#   * CA rules            281 of the 316 from the SDK's analysislevel_10_all.globalconfig, selected
#                         by $(AnalysisLevel) and $(AnalysisMode) in Directory.Build.props. Do not
#                         restate those here. The other 38 ARE here, in their own section below,
#                         because nothing else sets them and 11 ship disabled.
#   * package analyzers   eng/analyzers/all-rules.globalconfig, generated, one explicit entry per
#                         rule for all 1,065 of them — S, MA, RCS, VSTHRD, xUnit, NS, RS. Explicit
#                         per rule because no bulk entry can switch on a rule its analyzer ships
#                         disabled, and roughly a third of them are. Scoped to analyzers that
#                         arrive as NuGet packages, whose versions are pinned; the SDK's own are
#                         left out so the generated file does not depend on the floating SDK patch.
#                         Do not put exceptions there: a global config loses to this file, and the
#                         next regeneration would revert them.
#   * IDE rules           this file, via the category-Style entry below. They are not in the
#                         generated file because the code-style analyzers cannot be enumerated the
#                         way the others can; they are all enabled by default anyway, so promoting
#                         the category is enough.
#   * all exceptions      this file, each next to the reason for it.
#   * test-only relaxing  test/.editorconfig, which inherits everything here and turns off the few
#                         rules that fight readable tests.
#
# Everything set to `warning` here becomes an ERROR in Release, where
# <TreatWarningsAsErrors>true</TreatWarningsAsErrors> applies — that is, in `make ci`, in the
# pre-commit build and in the pipelines. Debug builds still only warn, so a work-in-progress change
# compiles and runs without being tidy first.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
# Both of these mirror the `trailing-whitespace` and `end-of-file-fixer` pre-commit hooks, so the
# editor and the hooks agree instead of fighting each other over the same lines.
trim_trailing_whitespace = true
insert_final_newline = true

# `end_of_line = lf` above matches `.gitattributes`, which marks these two as `eol=crlf` because
# they are interpreted by cmd.exe.
[*.{bat,cmd}]
end_of_line = crlf

[*.{csproj,props,targets,slnx,nuspec,config,json,yml,yaml,xml}]
indent_size = 2

# Recipe lines have to begin with a real tab; make rejects spaces there.
[Makefile]
indent_style = tab

# Note what is NOT here: `trim_trailing_whitespace = false`, the usual markdown exception that
# keeps two trailing spaces working as a hard line break. The `trailing-whitespace` pre-commit hook
# is configured without --markdown-linebreak-ext and strips them on the way into a commit, so that
# line break does not survive in this repository whatever the editor does. Use a blank line or a
# `<br>`. Add --markdown-linebreak-ext to the hook first if you want the other behaviour.
[*.md]
indent_size = 2

[*.cs]

# ----------------------------------------------------------------------------------------------
# Severity
# ----------------------------------------------------------------------------------------------

# Every code-style rule, on, as a warning. This is the code-style counterpart of
# <AnalysisMode>All</AnalysisMode>: opt in wholesale, then name the individual exceptions below
# with the reason each one is wrong for this repository, rather than hand-picking a short list and
# silently leaving the rest unenforced. The per-rule entries further down win over this one.
dotnet_analyzer_diagnostic.category-Style.severity = warning
dotnet_analyzer_diagnostic.category-CodeQuality.severity = warning

# Kept for Roslynator even though eng/analyzers/all-rules.globalconfig now names every RCS rule
# explicitly: this entry still catches a rule added by a Roslynator upgrade before the generated
# file has been refreshed, so a new rule arrives at warning rather than at whatever low severity it
# ships with. `make analyzers-verify` is what notices the file is stale; this is the safety net for
# the window before someone runs it.
dotnet_analyzer_diagnostic.category-Roslynator.severity = warning

# ----------------------------------------------------------------------------------------------
# The exceptions, each with the reason it is an exception
# ----------------------------------------------------------------------------------------------

# IDE0058: Remove unnecessary expression value.
#
# Off, not relaxed. The rule wants every discarded expression value assigned to `_`, and nearly
# every occurrence in this repository is a call made for its effect with a return value that is
# genuinely uninteresting: an awaited call in a test that asserts on the substitute rather than on
# the answer, and the NSubstitute `Received()` chains. `_ =` on each of those adds a character of
# noise per line and no information.
#
# The dangerous case this might otherwise catch — calling a pure method and throwing the result
# away, which means the call did nothing at all — is already CA1806, which is on at warning.
dotnet_diagnostic.IDE0058.severity = none

# IDE0045/IDE0046: Use conditional expression for assignment / for return.
#
# A three-branch decision is clearer as if/else-if/else than as the nested ternary the fix produces.
# Left as a suggestion so the IDE still offers it where a conditional expression genuinely does read
# better.
dotnet_diagnostic.IDE0045.severity = suggestion
dotnet_diagnostic.IDE0046.severity = suggestion

# IDE0290: Use primary constructor.
#
# A primary constructor cannot validate what it captures. A constructor that rejects a null
# dependency at construction time, instead of failing later on every call, has nowhere to put the
# throw in the generated form. A suggestion rather than off, because for a type that only stores its
# parameters the rule is right.
dotnet_diagnostic.IDE0290.severity = suggestion

# RCS1181: Convert comment to documentation comment.
#
# `//` and `///` are used deliberately and differently here. `///` documents the public API and is
# shipped in the .xml next to the package; `//` explains an implementation decision to whoever
# edits the line, and is addressed to a reader of the source rather than a consumer of the library.
# Promoting the second kind to the first would publish notes about private constants and test
# fixtures as API documentation.
dotnet_diagnostic.RCS1181.severity = none

# ----------------------------------------------------------------------------------------------
# Language and formatting preferences
#
# These are the questions the rules above ask but cannot answer on their own: unset, several of
# them default to the opposite of what this repository already does, so the bulk promotion would
# have turned the existing code into a wall of warnings. Each one is set to what the code does.
# ----------------------------------------------------------------------------------------------

# `var` throughout, which is what all 38 declarations in the repository use. Unset, these three
# default to preferring the explicit type and IDE0008 flags every one of them.
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true

# File-scoped namespaces, as every file here declares. This is what decides between IDE0161 (use
# file-scoped) and IDE0160 (use block-scoped); unset, the default is block-scoped and IDE0160 flags
# all eight files.
csharp_style_namespace_declarations = file_scoped

# No `this.` qualification, the .NET-wide convention. Worth knowing before relying on it: unlike
# everything else in this section, these four are NOT enforced on build. IDE0003 and IDE0009 ship
# as editor-only refactorings — setting either to `warning` explicitly was verified to report
# nothing on a file that qualified its field writes — so what these entries actually drive is the
# IDE and `dotnet format`. They are declared anyway so that the repository has one answer to the
# question rather than none, which is what it gave before this file existed.
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# `using` directives: outside the namespace, System first, groups separated by a blank line.
#
# Group separation was previously left unset because the two existing files disagreed about it, and
# IDE0055 enforces whichever value is set. Roslynator's RCS0015 forces the question — it reports
# ROS0003 until `roslynator_blank_line_between_using_directives` is answered — so the repository now
# answers it once, here and above, and the source was brought into line with it.
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Modern language features where they are unambiguous wins. These match the existing code — the
# property pattern in the temperature check, `nameof` in the argument exceptions — and are listed so
# the preference survives someone writing the older form.
# Expression bodies where the member fits on one line, which is what roslynator_body_style says
# above. Accessors and lambdas included; constructors and operators are left to the block form,
# where an expression body hides the fact that initialization is happening.
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_local_functions = when_on_single_line
csharp_style_expression_bodied_properties = when_on_single_line
csharp_style_expression_bodied_indexers = when_on_single_line
csharp_style_expression_bodied_accessors = when_on_single_line
csharp_style_expression_bodied_lambdas = when_on_single_line
csharp_style_expression_bodied_constructors = false
csharp_style_expression_bodied_operators = false

csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_pattern_matching_over_as_with_null_check = true
csharp_prefer_braces = true
dotnet_style_prefer_is_null_check_over_reference_equality_method = true
dotnet_style_null_propagation = true
dotnet_style_coalesce_expression = true
dotnet_style_prefer_conditional_expression_over_assignment = true
dotnet_style_prefer_conditional_expression_over_return = true
dotnet_style_readonly_field = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members

# ----------------------------------------------------------------------------------------------
# Naming
#
# IDE1006 checks the rules declared here and nothing else, so this block is what gives that rule
# anything to enforce. The styles describe the names the repository already uses; they are written
# out so the next contributor inherits them from the build instead of from reading existing files.
#
# There is deliberately no `Async` suffix rule. VSTHRD200 already covers it, and a naming rule
# would have to be switched off wholesale in test/.editorconfig, where method names are
# `{method}_When{inputs}_Then{expectation}` and the method under test being async says nothing
# about the test.
# ----------------------------------------------------------------------------------------------

dotnet_naming_rule.interfaces_are_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_are_prefixed_with_i.style = i_prefixed_pascal_case
dotnet_naming_rule.interfaces_are_prefixed_with_i.severity = warning

dotnet_naming_rule.type_parameters_are_prefixed_with_t.symbols = type_parameter_symbols
dotnet_naming_rule.type_parameters_are_prefixed_with_t.style = t_prefixed_pascal_case
dotnet_naming_rule.type_parameters_are_prefixed_with_t.severity = warning

dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = warning

dotnet_naming_rule.constants_are_pascal_case.symbols = constant_symbols
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_field_symbols
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning

dotnet_naming_rule.instance_fields_are_underscore_camel_case.symbols = instance_field_symbols
dotnet_naming_rule.instance_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.instance_fields_are_underscore_camel_case.severity = warning

dotnet_naming_rule.non_field_members_are_pascal_case.symbols = non_field_member_symbols
dotnet_naming_rule.non_field_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.non_field_members_are_pascal_case.severity = warning

dotnet_naming_rule.parameters_and_locals_are_camel_case.symbols = parameter_and_local_symbols
dotnet_naming_rule.parameters_and_locals_are_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel_case.severity = warning

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_symbols.type_parameter_symbols.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameter_symbols.applicable_accessibilities = *

dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *

dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.applicable_accessibilities = *
dotnet_naming_symbols.constant_symbols.required_modifiers = const

dotnet_naming_symbols.static_readonly_field_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field_symbols.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_field_symbols.required_modifiers = static, readonly

# Scoped to the accessibilities an underscore is conventional for. A public or protected_internal
# field is part of the API surface and would be PascalCase, but CA1051 forbids one outright, so
# there is no style to declare for it.
dotnet_naming_symbols.instance_field_symbols.applicable_kinds = field
dotnet_naming_symbols.instance_field_symbols.applicable_accessibilities = private, protected, internal, private_protected

dotnet_naming_symbols.non_field_member_symbols.applicable_kinds = property, method, event, namespace
dotnet_naming_symbols.non_field_member_symbols.applicable_accessibilities = *

dotnet_naming_symbols.parameter_and_local_symbols.applicable_kinds = parameter, local
dotnet_naming_symbols.parameter_and_local_symbols.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.i_prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_prefixed_pascal_case.required_prefix = I

dotnet_naming_style.t_prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_prefixed_pascal_case.required_prefix = T
# ----------------------------------------------------------------------------------------------
# Roslynator options the strict rule set requires
#
# Four Roslynator rules refuse to run until the repository states its preference, and say so as
# ROS0003 rather than staying quiet. Answering them is the point of enabling them.
# ----------------------------------------------------------------------------------------------

# RCS1018. Every declaration in this repository spells its accessibility out; `dotnet_style_
# require_accessibility_modifiers` above says the same thing to the IDE analyzers.
roslynator_accessibility_modifiers = explicit

# RCS1050, and only when there is an object initializer — the language already requires the
# parentheses when there is not. `new Thing { ... }` reads better than `new Thing() { ... }`, where
# the empty pair sits between the type and its values saying nothing.
roslynator_object_creation_parentheses_style = omit

# RCS1051. Parentheses around a conditional's condition are noise when precedence already makes it
# unambiguous, and the compiler does not need them.
roslynator_conditional_operator_condition_parentheses_style = omit

# RCS1207. A method group reads as the name of the thing being called; a lambda that does nothing
# but forward its arguments restates the signature to say the same thing.
roslynator_use_anonymous_function_or_method_group = method_group

# RCS1016, together with the two `use_block_body_when_*_spans_over_multiple_lines` options above:
# an expression body when the member fits on one line, a block body as soon as it does not. The
# `csharp_style_expression_bodied_*` entries below say the same thing to IDE0021-IDE0027.
#
# Chosen deliberately rather than inherited: the first version of this file said `block` because the
# four files in the example library happened to be block-bodied, which made the template impose an
# accident of its own sample on everything derived from it. `=>` for a one-line member is the
# mainstream .NET convention and the one that needs no reformatting to adopt.
roslynator_body_style = expression

# RCS1090. ConfigureAwait(false) on every await in library code, which is what CA2007 and MA0004
# already require here — and what test/.editorconfig switches off for test code, where there is no
# synchronization context worth avoiding.
roslynator_configure_await = true

# RCS1254. No enum in the repository uses flags yet; `1 << 0, 1 << 1, 1 << 2` is chosen over
# `1, 2, 4` because the shift makes the bit position explicit and does not need recomputing by hand
# when a member is inserted.
roslynator_enum_flag_value_style = shift_operator

# RCS1078. `""` over `string.Empty`: it is a compile-time constant, so the same spelling works in an
# attribute argument, a constant pattern and a default parameter value, where the static field does
# not compile.
roslynator_empty_string_style = literal

# RCS1248. `is null` over `== null`, matching `dotnet_style_prefer_is_null_check_over_reference_
# equality_method` above. The pattern cannot be intercepted by an overloaded `==`, so it asks the
# question it appears to ask even on a type that redefines equality.
roslynator_null_check_style = pattern_matching

# The rest of Roslynator's options, set so that ROS0003 cannot come back. Roslynator reveals these
# a few at a time — a rule only reports its missing option once it is reached — so answering the
# whole list at once is the only way to converge. Every value below either matches what the
# repository already does or, where there was no precedent, states the choice for the first time.

# Layout. A binary operator ends the line it continues from, while a ternary's `?` and `:` begin
# theirs.
roslynator_binary_operator_new_line = after
roslynator_conditional_operator_new_line = before
roslynator_equals_token_new_line = after
roslynator_arrow_token_new_line = after
roslynator_null_conditional_operator_new_line = before
roslynator_accessor_braces_style = single_line_when_expression_is_on_single_line
roslynator_block_braces_style = single_line_when_empty
roslynator_new_line_at_end_of_file = true
roslynator_new_line_before_while_in_do_statement = true
roslynator_blank_line_after_file_scoped_namespace_declaration = true
roslynator_blank_line_between_switch_sections = true
roslynator_blank_line_between_closing_brace_and_switch_section = true
roslynator_blank_line_between_single_line_accessors = false
roslynator_trailing_comma_style = include_when_multiline
roslynator_tab_length = 4
roslynator_max_line_length = 200

# `using` groups separated by a blank line, which is what the test file already does and what this
# repository now does everywhere; `dotnet_separate_import_directive_groups` below says the same to
# IDE0055, and the source was brought into line rather than the rule bent around it.
roslynator_blank_line_between_using_directives = separate_groups

# Style. `var` throughout and a collection expression where one fits, matching the
# `csharp_style_var_*` settings below; the type is named only where inference cannot see it.
roslynator_use_var = always
roslynator_use_var_instead_of_implicit_object_creation = true
roslynator_use_collection_expression = true
roslynator_object_creation_type_style = implicit_when_type_is_obvious
roslynator_array_creation_type_style = implicit_when_type_is_obvious
roslynator_prefix_field_identifier_with_underscore = true
roslynator_use_block_body_when_declaration_spans_over_multiple_lines = true
roslynator_use_block_body_when_expression_spans_over_multiple_lines = true

# `(flags & Flag.X) != 0` over `flags.HasFlag(Flag.X)`, which boxes its argument, and `while (true)`
# over `for (;;)`, which says the same thing with punctuation.
roslynator_enum_has_flag_style = operator
roslynator_infinite_loop_style = while

# Multi-line `/// <summary>`, the same answer MA0177 is switched off for below: it is what the .NET
# libraries use and what every doc comment here already does.
roslynator_doc_comment_summary_style = multi_line

# ----------------------------------------------------------------------------------------------
# Relaxations forced by the all-rules default
#
# With every rule of every analyzer switched on by eng/analyzers/all-rules.globalconfig, the rules
# below are the ones that are wrong for THIS repository rather than wrong in general. Each is off
# with the reason, and each will survive the next regeneration of that file because .editorconfig
# wins over a global config.
#
# Nothing here is off because it was inconvenient. Where the strict default found something real
# it was fixed in the code instead: an equality check became a pattern match, a magic number became
# a named constant, and CA1017/S3992 became the assembly attributes in Directory.Build.targets.
# ----------------------------------------------------------------------------------------------

# MA0215 and RCS1174: return the task instead of awaiting it / remove redundant async-await.
#
# Eliding the await drops the method's own frame from the stack trace of anything that fails
# inside it, and moves an argument exception from the synchronous part of the call to the returned
# task, so the caller sees it only on await. Both matter more to a service that has to be debugged
# from a log line than one state-machine allocation does. The case that settles it is a method that
# validates its arguments, returns an awaited call on one path and throws on the other: eliding the
# await moves that throw from the call into the returned task, so the caller sees it only on await.
dotnet_diagnostic.MA0215.severity = none
dotnet_diagnostic.RCS1174.severity = none

# RCS1002 and RCS1004: remove braces / remove braces from if-else.
#
# A direct contradiction of `csharp_prefer_braces = true` above, which IDE0011 enforces. Braces
# always — the single-statement `if` without them is where a later edit silently adds a second
# statement outside the branch — so these two have to go; keeping both rules would mean the build
# demanding every edit be undone.
dotnet_diagnostic.RCS1002.severity = none
dotnet_diagnostic.RCS1004.severity = none

# MA0177 and MA0219: single-line XML comment syntax / set the language attribute.
#
# The multi-line `/// <summary>` form is what the .NET libraries use and what every doc comment here
# already uses, and `<c>0.25</c>` does not become clearer as `<c lang="csharp">0.25</c>`. These are
# house-style questions where this house has already answered differently.
dotnet_diagnostic.MA0177.severity = none
dotnet_diagnostic.MA0219.severity = none

# S1309: do not suppress issues.
#
# This forbids `#pragma warning disable` outright, which would make a documented, narrowly scoped
# suppression impossible — including a narrow `disable CA1848` around a call site where the ILogger
# extension methods are the right choice and a comment says why. A suppression that carries its
# reason is the mechanism working, not a smell, and IDE0079 still removes suppressions that have
# stopped suppressing anything.
dotnet_diagnostic.S1309.severity = none

# S1312: make the logger private static readonly.
#
# Right for a static logger obtained from a factory, wrong for an injected one. ILogger<T> arrives
# through the constructor, belongs to the instance, and cannot be static without abandoning
# dependency injection for the one dependency every type has.
dotnet_diagnostic.S1312.severity = none

# S3242: use the more general type ILogger instead of ILogger<T>.
#
# ILogger<T> is the type the container registers and the thing that gives log entries their
# category. Widening the parameter to ILogger would make the type unresolvable by DI and silently
# drop the category from every message it writes.
dotnet_diagnostic.S3242.severity = none

# S1451: add or update the header of this file.
#
# The licence is stated once, in LICENSE at the root, and again in $(PackageLicenseExpression) so it
# reaches the package metadata. A copy in a comment at the top of every file is a third statement
# that no tool checks and that goes stale on the next relicence or year change.
dotnet_diagnostic.S1451.severity = none

# S4055: replace this string literal with one from a ResourceManager.
#
# This repository ships one language. Routing exception messages and log templates through a
# ResourceManager would add a resource lookup, a .resx to keep in step and an indirection in every
# message, to localize text that has no second locale to be localized into.
dotnet_diagnostic.S4055.severity = none

# RCS1223: mark the type with DebuggerDisplay.
#
# Worth it for a type with enough state that the debugger's default rendering is unhelpful. Applied
# to every DTO — two properties and nothing else — it is attribute noise on the declaration.
dotnet_diagnostic.RCS1223.severity = none
# ----------------------------------------------------------------------------------------------
# The CA rules <AnalysisMode>All</AnalysisMode> does not reach
#
# The SDK implements that property as a global config of explicit per-rule entries, and it covers
# 281 of the 316 CA ids the analyzer ships. The other 38 are listed here because nothing else sets
# them, and 11 of those are shipped DISABLED - so without this block they never ran, however strict
# the rest of the configuration looked.
#
# Written out by hand rather than generated, deliberately. eng/analyzers/all-rules.globalconfig is
# generated from the analyzers the projects resolve, and it covers only the ones that arrive as
# NuGet packages, whose versions are pinned by Directory.Packages.props and the lock files. The CA
# analyzer ships inside the SDK, and global.json floats the SDK patch (`rollForward: latestPatch`),
# so generating these made the committed file depend on which patch the machine happened to have:
# it was produced on 10.0.203 and CI resolved 10.0.204, and `make analyzers-verify` failed with
# nothing a developer could usefully do about it. Stable text has no such problem.
#
# The trade is explicit: if a later SDK ships a CA rule that it also leaves unconfigured, that rule
# sits at its own default until someone adds it here. That is a gap rather than a broken build,
# which is the right way round. CA1516 is absent on purpose - the SDK sets it to `none` and that
# decision is theirs to make.
# ----------------------------------------------------------------------------------------------

# Code metrics: inheritance depth, cyclomatic complexity, maintainability index and class coupling.
# All four ship disabled, which is why a codebase can grow a 40-dependency entry point without ever
# being told. Thresholds come from eng/analyzers/CodeMetricsConfig.txt; CA1509 reports a malformed
# entry in it.
dotnet_diagnostic.CA1501.severity = warning
dotnet_diagnostic.CA1502.severity = warning
